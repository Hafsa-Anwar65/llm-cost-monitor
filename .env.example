# Copy to .env and edit. docker compose reads this file automatically.
# For local runs:  uvicorn proxy.main:app --env-file .env

# Where request logs are stored (local runs only; Docker uses a volume at /data)
DB_PATH=data/monitor.db
PRICING_PATH=pricing.json

# Daily budget in USD (UTC day). Leave empty to disable alerts.
DAILY_BUDGET_USD=
# Slack (or Discord) incoming-webhook URL for budget alerts. Optional.
SLACK_WEBHOOK_URL=

# Store a 2,000-char preview of each prompt (privacy: leave off unless you need it)
LOG_PROMPTS=0

# Add stream_options.include_usage to OpenAI streaming chat requests so tokens can be counted
INJECT_OPENAI_USAGE=1

# Upstream overrides (e.g. Azure OpenAI or an internal gateway)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com

# Used only by scripts/demo_traffic.py (never read by the proxy itself)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEMO_ANTHROPIC_MODEL=
# DEMO_OPENAI_MODEL=gpt-4o-mini
